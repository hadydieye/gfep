# Contrôle d'accès du LDAP de test : le compte de service svc-ldapreader lit
# l'annuaire (hors mots de passe) ; chaque utilisateur peut s'authentifier.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=gnpaytrust,dc=local" write by anonymous auth by * none
olcAccess: {1}to * by self read by dn="cn=admin,dc=gnpaytrust,dc=local" write by dn="cn=svc-ldapreader,ou=ServiceAccounts,dc=gnpaytrust,dc=local" read by * none
