generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOMAIN: IDENTITY
// ============================================================

enum AuthProvider {
  LOCAL
  ACTIVE_DIRECTORY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  email            String       @unique
  passwordHash     String? // null si auth_provider = ACTIVE_DIRECTORY
  authProvider     AuthProvider @default(LOCAL)
  status           UserStatus   @default(ACTIVE)
  failedLoginCount Int          @default(0)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  employeeIdentity EmployeeIdentity?
  sessions         Session[]
  userRoles        UserRole[]
  authEvents       AuthEvent[]
  notifications    Notification[]
  auditLogsAsActor AuditLog[]        @relation("AuditActor")
  documentComments DocumentComment[]
  settingsUpdated  SystemSetting[]   @relation("SettingUpdater")

  @@index([email])
  @@map("users")
}

model EmployeeIdentity {
  id           String    @id @default(uuid())
  userId       String    @unique
  employeeId   String    @unique
  adObjectGuid String?   @unique
  adSid        String?   @unique
  adUsername   String?
  adUpn        String?
  lastSyncAt   DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_identities")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  sessionTokenHash String    @unique
  ipAddress        String
  userAgent        String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Table de correspondance groupe AD -> rôle applicatif
model AdGroupRoleMapping {
  id        String @id @default(uuid())
  adGroupDn String @unique
  roleId    String

  role Role @relation(fields: [roleId], references: [id])

  @@map("ad_group_role_mapping")
}

// ============================================================
// DOMAIN: ORGANIZATION
// ============================================================

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  managerId   String?  @unique
  createdAt   DateTime @default(now())

  manager            Employee?          @relation("DepartmentManager", fields: [managerId], references: [id])
  employees          Employee[]         @relation("DepartmentEmployees")
  positions          Position[]
  documentCategories DocumentCategory[]
  transactions       Transaction[]
  invoices           Invoice[]

  @@map("departments")
}

model Position {
  id             String  @id @default(uuid())
  title          String
  description    String?
  departmentId   String
  hierarchyLevel Int // 1 = direction, plus le chiffre augmente plus le niveau est opérationnel

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@map("positions")
}

model Employee {
  id                String           @id @default(uuid())
  employeeNumber    String           @unique // ex: GF-2026-001
  firstName         String
  lastName          String
  professionalEmail String           @unique
  phone             String?
  departmentId      String
  positionId        String
  managerId         String?
  hireDate          DateTime
  employmentStatus  EmploymentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  department        Department        @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  position          Position          @relation(fields: [positionId], references: [id])
  manager           Employee?         @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  directReports     Employee[]        @relation("EmployeeHierarchy")
  managesDepartment Department?       @relation("DepartmentManager")
  identity          EmployeeIdentity?
  ownedDocuments    Document[]        @relation("DocumentOwner")

  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

// ============================================================
// DOMAIN: ACCESS CONTROL
// ============================================================

model Role {
  id          String @id @default(uuid())
  name        String @unique // ex: SUPER_ADMIN, HR_MANAGER, EMPLOYEE
  description String

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  adGroupMappings AdGroupRoleMapping[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  resource    String // ex: "employees", "documents", "finance"
  action      String // ex: "read", "write", "delete", "approve"
  description String

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedBy String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// DOMAIN: DOCUMENTS
// ============================================================

enum ConfidentialityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentPermissionType {
  READ
  WRITE
  DELETE
}

enum DocumentValidationStatus {
  PENDING
  VALIDATED
  REJECTED
}

model DocumentCategory {
  id           String  @id @default(uuid())
  name         String  @unique
  description  String?
  departmentId String?

  department Department? @relation(fields: [departmentId], references: [id])
  documents  Document[]

  @@map("document_categories")
}

model Document {
  id                   String                   @id @default(uuid())
  title                String
  description          String?
  categoryId           String
  ownerId              String
  storagePath          String
  mimeType             String
  fileSize             Int
  confidentialityLevel ConfidentialityLevel     @default(INTERNAL)
  validationStatus     DocumentValidationStatus @default(PENDING)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  category    DocumentCategory     @relation(fields: [categoryId], references: [id])
  owner       Employee             @relation("DocumentOwner", fields: [ownerId], references: [id])
  permissions DocumentPermission[]
  comments    DocumentComment[]

  @@index([categoryId])
  @@index([ownerId])
  @@map("documents")
}

model DocumentPermission {
  id         String                 @id @default(uuid())
  documentId String
  userId     String
  permission DocumentPermissionType
  grantedBy  String
  grantedAt  DateTime               @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId, permission])
  @@map("document_permissions")
}

model DocumentComment {
  id         String   @id @default(uuid())
  documentId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_comments")
}

// ============================================================
// DOMAIN: FINANCE
// ============================================================

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Transaction {
  id              String            @id @default(uuid())
  reference       String            @unique
  transactionType TransactionType
  amount          Decimal           @db.Decimal(14, 2)
  currency        String            @default("GNF")
  description     String?
  createdBy       String
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  departmentId    String?

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([createdBy])
  @@index([departmentId])
  @@map("transactions")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  clientName    String
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("GNF")
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  createdBy     String
  createdAt     DateTime      @default(now())
  departmentId  String?

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([createdBy])
  @@index([departmentId])
  @@map("invoices")
}

// ============================================================
// DOMAIN: APPLICATION
// ============================================================

enum NotificationType {
  INFO
  WARNING
  SECURITY
  DOCUMENT_SHARED
  ROLE_CHANGED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_LOCKED
  AD_BIND_FAILED
  AD_UNREACHABLE
  AD_SERVICE_BIND_FAILED
  AD_USER_NOT_FOUND
  AD_NO_EMPLOYEE_MATCH
  AD_NO_ROLE_MAPPING
  AD_LOCAL_ACCOUNT_CONFLICT
}

model AuthEvent {
  id                   String        @id @default(uuid())
  userId               String?
  authenticationMethod AuthProvider
  eventType            AuthEventType
  sourceIp             String
  timestamp            DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@map("auth_events")
}

// ============================================================
// DOMAIN: SECURITY & AUDIT
// ============================================================

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  action       String // ex: "employee.update", "role.assign"
  resourceType String // ex: "Employee", "Document"
  resourceId   String
  oldValues    Json?
  newValues    Json?
  sourceIp     String
  timestamp    DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityEvent {
  id          String           @id @default(uuid())
  eventType   String
  severity    SecuritySeverity
  source      String
  description String
  metadata    Json?
  timestamp   DateTime         @default(now())

  @@index([severity, timestamp])
  @@map("security_events")
}

// Catalogue des scénarios pédagogiques (hors périmètre de ce document produit,
// détaillé dans les documents Enterprise Breach — table listée ici pour la cohérence du schéma)
model LabScenario {
  id                    String   @id @default(uuid())
  scenarioCode          String   @unique // ex: WEB-01, AD-02
  name                  String
  vulnerabilityCategory String
  description           String
  mode                  String // "lab" | "secure"
  enabled               Boolean  @default(false)
  createdAt             DateTime @default(now())

  executions ScenarioExecution[]

  @@map("lab_scenarios")
}

model ScenarioExecution {
  id                String    @id @default(uuid())
  scenarioId        String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  result            String?
  evidenceReference String?

  scenario LabScenario @relation(fields: [scenarioId], references: [id])

  @@map("scenario_executions")
}

// ============================================================
// DOMAIN: SETTINGS
// ============================================================

// Paramètres système modifiables (N16) : clé primaire = nom du paramètre,
// valeur JSON. Seul session.ttlHours est actuellement modifiable (valeur entière, 1–12).
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@map("system_settings")
}
