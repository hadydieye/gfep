# PostgreSQL (Docker Compose)
POSTGRES_DB=gfep_db
POSTGRES_USER=gfep_user
POSTGRES_PASSWORD=change_me_in_dotenv

# Backend
DATABASE_URL=postgresql://gfep_user:change_me_in_dotenv@localhost:5432/gfep_db
PORT=3001
SESSION_COOKIE_NAME=gfep_session
# Stockage des fichiers de documents (défaut : apps/backend/storage/documents)
DOCUMENTS_STORAGE_DIR=
# Seed (développement uniquement) : mots de passe de démonstration par rôle, facultatifs
SEED_PASSWORD_SUPER_ADMIN=
SEED_PASSWORD_DEPARTMENT_MANAGER=
SEED_PASSWORD_EMPLOYEE=
SEED_PASSWORD_ACCOUNTANT=
SEED_PASSWORD_IT_ADMINISTRATOR=
SEED_PASSWORD_IT_TECHNICIAN=
SEED_PASSWORD_HR_MANAGER=
SEED_PASSWORD_AUDITOR=

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Active Directory (étape 2.7) — en MVP 2, LDAP de test Docker uniquement (profil ad-test), jamais un vrai AD.
# AD_LDAP_URL vide : AD non configuré (connexion AD refusée en 503, aucun repli local).
AD_LDAP_URL=
AD_BASE_DN=dc=gnpaytrust,dc=local
AD_USER_ID_ATTRIBUTE=uid
AD_MAIL_ATTRIBUTE=mail
AD_GROUPS_ATTRIBUTE=memberOf
AD_GUID_ATTRIBUTE=entryUUID
AD_SID_ATTRIBUTE=
AD_BIND_DN=cn=svc-ldapreader,ou=ServiceAccounts,dc=gnpaytrust,dc=local
AD_BIND_PASSWORD=
AD_CA_CERT_PATH=
AD_TIMEOUT_MS=3000
# LDAP de test : port hôte (636 par défaut ; ex. 1636 avec podman rootless) et mot de passe admin du conteneur
LDAP_TEST_PORT=636
LDAP_TEST_ADMIN_PASSWORD=
